# Base de datos (PostgreSQL con pgvector)
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=cyberpunk_agent
PG_HOST=localhost
PG_PORT=5434

# Autenticacion (JWT)
JWT_SECRET=tu_clave_secreta_super_segura_cambiar_en_produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Documentacion interactiva (Swagger)
ENABLE_DOCS=True

# Modelo local (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:3b
EMBEDDING_MODEL=bge-m3

# Configuracion RAG
COLLECTION_NAME=cyberpunk_kb
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
SIMILARITY_THRESHOLD=0.5

# Carga de documentos
MAX_UPLOAD_MB=15

# CORS (Origenes permitidos del frontend, separados por comas)
# Ejemplo: CORS_ORIGINS=http://localhost:5173,https://mi-frontend.vercel.app
CORS_ORIGINS=CORS_ORIGINS=http://localhost:5173

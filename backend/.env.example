# Copia este archivo a .env y ajusta los valores. NUNCA subas .env a GitHub.

# --- Base de datos (PostgreSQL + pgvector) ---
# El docker-compose publica la base en el puerto 5433 del equipo para no
# chocar con un PostgreSQL local instalado en el 5432.
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=cyberpunk_agent
PG_HOST=localhost
PG_PORT=5434

# --- Autenticación (JWT propio) ---
# Genera una clave larga y aleatoria, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Documentación interactiva (Swagger en /docs y /openapi.json) ---
# true en desarrollo y demo; false en producción para no dejar rutas abiertas.
ENABLE_DOCS=true

# --- Modelo local (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:3b
EMBEDDING_MODEL=bge-m3

# --- RAG ---
COLLECTION_NAME=cyberpunk_kb
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
# Umbral mínimo de similitud: se calibra en la fase 4 con preguntas reales.
SIMILARITY_THRESHOLD=0.55

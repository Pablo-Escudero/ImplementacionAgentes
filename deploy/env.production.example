# Plantilla de producción. En el servidor cópiala a la RAÍZ del repo como ".env":
#   cp deploy/env.production.example .env && nano .env
# NUNCA subas el .env real a GitHub.

# --- Dominio público (DuckDNS u otro) que apunta a la IP elástica del servidor ---
DOMAIN=cambia-esto.duckdns.org

# --- Base de datos (servicio "db" de docker-compose.prod.yml) ---
PG_USER=postgres
# Contraseña aleatoria solo con letras y números (evita $ y # en el .env). Genérala con:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
PG_PASSWORD=cambia-esto
PG_DB=cyberpunk_agent

# --- Autenticación (JWT propio) ---
# Genera la clave en el servidor:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Swagger apagado en producción ---
ENABLE_DOCS=false

# --- Modelo local (Ollama en tu PC, alcanzado por Tailscale) ---
# Reemplaza por la IP de Tailscale de tu PC (empieza por 100.).
OLLAMA_BASE_URL=http://100.x.y.z:11434
CHAT_MODEL=qwen2.5:3b
EMBEDDING_MODEL=bge-m3

# --- RAG ---
COLLECTION_NAME=cyberpunk_kb
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
SIMILARITY_THRESHOLD=0.55

# --- Carga de documentos ---
MAX_UPLOAD_MB=15

# --- CORS: URLs del frontend separadas por comas (vacío = sin CORS) ---
# Ejemplo: CORS_ORIGINS=https://mi-front.netlify.app
CORS_ORIGINS=
